CREATE TABLE card (
    id TEXT NOT NULL PRIMARY KEY,
    topic_id TEXT NOT NULL,
    front TEXT NOT NULL,
    back TEXT NOT NULL,
    answer_type TEXT NOT NULL,
    key_points TEXT NOT NULL DEFAULT '[]',
    accepted_aliases TEXT NOT NULL DEFAULT '[]',
    tile_answer TEXT,
    mcq TEXT,
    explanation TEXT,
    numeric_value REAL,
    numeric_tolerance REAL,
    numeric_unit TEXT,
    source TEXT NOT NULL,
    review_status TEXT NOT NULL,
    spec_ref TEXT NOT NULL DEFAULT '',
    pack_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

selectAll:
SELECT id AS id, topic_id AS topicId, front AS front, back AS back,
       answer_type AS answerType, key_points AS keyPoints,
       accepted_aliases AS acceptedAliases, tile_answer AS tileAnswer,
       mcq AS mcq, explanation AS explanation, numeric_value AS numericValue,
       numeric_tolerance AS numericTolerance, numeric_unit AS numericUnit,
       source AS source, review_status AS reviewStatus, spec_ref AS specRef,
       pack_id AS packId, created_at AS createdAt, updated_at AS updatedAt
FROM card;

upsert:
INSERT OR REPLACE INTO card(
    id, topic_id, front, back, answer_type, key_points, accepted_aliases,
    tile_answer, mcq, explanation, numeric_value, numeric_tolerance, numeric_unit,
    source, review_status, spec_ref, pack_id, created_at, updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM card
WHERE id = ?;

deleteByPack:
DELETE FROM card
WHERE pack_id = ?;

selectIdsByPack:
SELECT id AS id
FROM card
WHERE pack_id = ?;
