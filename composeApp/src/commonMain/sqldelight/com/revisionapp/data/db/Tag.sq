CREATE TABLE tag (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    tag_group TEXT NOT NULL,
    source TEXT NOT NULL
);

selectAll:
SELECT id AS id, name AS name, tag_group AS tagGroup, source AS source
FROM tag
ORDER BY tag_group ASC, name ASC;

upsert:
INSERT OR REPLACE INTO tag(id, name, tag_group, source)
VALUES (?, ?, ?, ?);

deleteById:
DELETE FROM tag
WHERE id = ?;
