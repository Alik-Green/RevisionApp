    {
      "id": "0001",
      "front": "In what direction does the centripetal force act, and what effect does it have on the speed?",
      "back": "Towards the centre of the circle, perpendicular to the velocity, so it changes the direction of motion but not the speed.",
      "keyPoints": [
        {
          "text": "towards the centre",
          "mustInclude": true
        },
        {
          "text": "perpendicular to the velocity",
          "synonyms": [
            "at right angles to motion"
          ]
        },
        {
          "text": "changes direction not speed",
          "synonyms": [
            "no work is done"
          ],
          "mustInclude": true
        }
      ],
      "mcq": {
        "correct": "Towards the centre of the circle, perpendicular to the velocity, so it changes the direction of motion but not the speed.",
        "distractors": [
          "Outwards from the centre, increasing the speed",
          "Along the direction of travel, keeping the speed constant",
          "Towards the centre, increasing the speed"
        ]
      },
      "explanation": "A force at right angles to the motion does no work, so the kinetic energy and speed stay constant while the velocity keeps changing direction.",
