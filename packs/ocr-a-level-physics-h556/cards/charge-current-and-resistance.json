    {
      "id": "0003",
      "front": "Define resistance, and state the condition under which Ohm's law holds.",
      "back": "Resistance is the ratio of potential difference to current, R = V/I, in ohms. Ohm's law holds for a conductor kept at constant temperature, where the current is directly proportional to the potential difference.",
      "keyPoints": [
        {
          "text": "ratio of potential difference to current",
          "synonyms": [
            "R = V/I"
          ],
          "mustInclude": true
        },
        {
          "text": "ohm",
          "synonyms": [
            "ohms"
          ],
          "mustInclude": true
        },
        {
          "text": "constant temperature",
          "synonyms": [
            "constant physical conditions"
          ],
          "mustInclude": true
        },
        {
          "text": "current directly proportional to potential difference",
          "mustInclude": true
        }
      ],
      "explanation": "A filament lamp and a diode both have a resistance but are not ohmic, because the proportionality only holds while the temperature stays fixed.",
      "reviewStatus": "AI_UNREVIEWED",
      "specRef": "4.2.2",
      "tagRefs": [
        "ocr",
        "a-level",
        "physics",
        "m4"
      ]
    },
    {
      "id": "0004",
      "front": "Write the three equations for electrical power.",
      "back": "P = VI, and substituting V = IR gives P = I^2 R and P = V^2/R.",
      "keyPoints": [
        {
          "text": "P = VI",
          "mustInclude": true
        },
        {
          "text": "P = I^2 R",
          "mustInclude": true
        },
        {
          "text": "P = V^2/R",
          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "P = IV"
      ],
      "explanation": "Choosing between I^2 R and V^2/R depends on what stays constant: series components share a current, parallel components share a potential difference.",
      "reviewStatus": "AI_UNREVIEWED",
      "specRef": "4.2.1",
