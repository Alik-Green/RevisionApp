        "physics",
        "m3"
      ]
    },
    {
      "id": "0002",
      "front": "What does the gradient of a displacement-time graph represent?",
      "back": "The velocity.",
      "keyPoints": [
        {
          "text": "velocity",
          "synonyms": [
            "speed and direction"
          ],
          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "speed if only the magnitude is wanted"
      ],
      "tileAnswer": [
        "The",
        "velocity."
      ],
      "mcq": {
        "correct": "The velocity.",
        "distractors": [
          "The acceleration",
          "The resultant force",
          "The average speed over the whole journey"
        ]
      },
      "explanation": "Velocity is the rate of change of displacement with time, which is exactly what a gradient measures. A negative gradient means motion back towards the start.",
      "reviewStatus": "AI_UNREVIEWED",
      "specRef": "3.1.1",
      "tagRefs": [
