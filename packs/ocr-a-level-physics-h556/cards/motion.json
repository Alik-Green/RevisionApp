    {
      "id": "0001",
      "front": "What is the difference between distance travelled and displacement?",
      "back": "Distance is the total path length travelled and is a scalar; displacement is the straight-line change in position from start to finish, with a direction.",
      "keyPoints": [
        {
          "text": "distance is total path length",
          "synonyms": [
            "how far travelled"
          ],
          "mustInclude": true
        },
        {
          "text": "displacement is straight line from start to end",
          "synonyms": [
            "change in position"
          ],
          "mustInclude": true
        },
        {
          "text": "displacement has direction",
          "synonyms": [
            "vector"
          ]
        }
      ],
      "reviewStatus": "AI_UNREVIEWED",
      "specRef": "3.1.1",
      "tagRefs": [
        "ocr",
