    {
      "id": "0003",
      "front": "What does the area under a velocity-time graph represent?",
      "back": "The displacement.",
      "keyPoints": [
        {
          "text": "displacement",
          "synonyms": [
            "change in position"
          ],
          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "distance travelled if the direction never reverses"
      ],
      "tileAnswer": [
        "The",
        "displacement."
      ],
      "mcq": {
        "correct": "The displacement.",
        "distractors": [
          "The acceleration",
          "The average velocity",
          "The rate of change of speed"
        ]
      },
      "explanation": "Area is velocity multiplied by time, which is a displacement. The gradient of the same graph would give the acceleration.",
