    {
      "id": "0005",
      "front": "Why must a fraction be proper before it is split into partial fractions, and what is done if it is not?",
      "back": "Partial fractions only apply when the numerator's degree is less than the denominator's. Otherwise divide first, giving a polynomial plus a proper fraction, and decompose only the fraction part.",
      "answerType": "SELF_GRADE",
      "keyPoints": [
        {
          "text": "numerator degree must be lower than the denominator's",
          "synonyms": [
            "proper fraction"
          ],
          "mustInclude": true
        },
        {
          "text": "divide first",
          "synonyms": [
            "algebraic division",
            "long division"
          ],
          "mustInclude": true
        },
        {
          "text": "polynomial plus a proper fraction",
          "synonyms": [
            "quotient and remainder"
          ]
        }
      ],
      "explanation": "An improper fraction has a polynomial part that no sum of proper fractions can represent.",
