          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "A/(x-2) + B/(x+1)"
      ],
      "mcq": {
        "correct": "$\\frac{A}{x - 2} + \\frac{B}{x + 1}$",
        "distractors": [
          "$\\frac{A}{x - 2} \\times \\frac{B}{x + 1}$",
          "$\\frac{Ax + B}{(x - 2)(x + 1)}$",
          "$\\frac{A}{x - 2} + \\frac{B}{x - 2}$"
        ]
      },
      "explanation": "Each distinct linear factor in the denominator contributes one fraction with a constant numerator.",
