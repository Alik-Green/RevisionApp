      "id": "0005",
      "front": "Evaluate $\\int_0^1 x e^{2x}\\,dx$ exactly.",
      "back": "$\\frac{e^2 + 1}{4}$",
      "answerType": "EXPRESSION",
      "keyPoints": [
        {
          "text": "(e^2 + 1)/4",
          "synonyms": [
            "1/4 (e^2 + 1)"
          ],
          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "(e\u00b2 + 1)/4"
      ],
      "mcq": {
        "correct": "$\\frac{e^2 + 1}{4}$",
        "distractors": [
          "$\\frac{e^2 - 1}{4}$",
          "$\\frac{e^2 + 1}{2}$",
          "$e^2$"
        ]
      },
      "explanation": "By parts with $u = x$: $\\left[\\frac{xe^{2x}}{2}\\right]_0^1 - \\int_0^1 \\frac{e^{2x}}{2}dx = \\frac{e^2}{2} - \\left[\\frac{e^{2x}}{4}\\right]_0^1 = \\frac{e^2}{2} - \\frac{e^2 - 1}{4} = \\frac{e^2 + 1}{4}$.",
      "reviewStatus": "AI_UNREVIEWED",
