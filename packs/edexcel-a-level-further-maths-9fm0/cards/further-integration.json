      "id": "0001",
      "front": "State the formula for integration by parts.",
      "back": "$\\int u\\,dv = uv - \\int v\\,du$",
      "answerType": "EXPRESSION",
      "keyPoints": [
        {
          "text": "\u222bu dv = uv - \u222bv du",
          "mustInclude": true
        }
      ],
      "acceptedAliases": [
        "\u222b u (dv/dx) dx = uv - \u222b v (du/dx) dx"
      ],
      "mcq": {
        "correct": "$\\int u\\,dv = uv - \\int v\\,du$",
        "distractors": [
          "$\\int u\\,dv = uv + \\int v\\,du$",
          "$\\int u\\,dv = u v' - \\int v u'\\,dx$",
          "$\\int u\\,dv = \\int u\\,dx \\int dv$"
        ]
      },
      "explanation": "It is the product rule run backwards, which is why the second term keeps a minus sign.",
