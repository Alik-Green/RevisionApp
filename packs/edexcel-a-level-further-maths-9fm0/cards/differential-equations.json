    {
      "id": "0009",
      "front": "Solve $\\frac{d^2y}{dx^2} + 4y = 0$ given $y = 1$ and $\\frac{dy}{dx} = 6$ when $x = 0$.",
      "back": "$y = \\cos 2x + 3\\sin 2x$",
      "answerType": "EXPRESSION",
      "keyPoints": [
        {
          "text": "the auxiliary equation m^2 + 4 = 0 gives m = plus or minus 2i",
          "synonyms": [
            "complex roots"
          ],
