      "id": "fm-modulus",
      "topicId": "complex-numbers",
      "topicLabel": "Complex numbers",
      "prompt": "Find the modulus of 3 + 4i.",
      "answer": {
        "type": "text_input",
        "acceptedAnswers": [
          "5",
          "5.0"
        ]
      },
      "explanation": "The modulus is the distance from the origin: square root of 3 squared plus 4 squared, which is 5.",
      "answerInstruction": "Type the numerical value of the modulus."
    },
    {
      "id": "fm-conjugate",
      "topicId": "complex-numbers",
      "topicLabel": "Complex numbers",
      "prompt": "What is the complex conjugate of 2 - 5i?",
      "answer": {
        "type": "text_input",
        "acceptedAnswers": [
          "2 + 5i",
          "2+5i"
        ]
      },
      "explanation": "The conjugate keeps the real part and changes the sign of the imaginary part.",
      "answerInstruction": "Type the complex number in a + bi form."
    },
