        "type": "multiple_choice",
        "options": [
          {
            "id": "a",
            "text": "The matrix is invertible"
          },
          {
            "id": "b",
            "text": "Every entry is positive"
          },
          {
            "id": "c",
            "text": "The matrix must be diagonal"
          }
